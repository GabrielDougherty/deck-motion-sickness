{
    "file_format_version": "1.2.0",
    "layer": {
        "name": "VK_LAYER_MOTIONSAFE_overlay",
        "type": "GLOBAL",
        "library_path": "@LIBRARY_PATH@",
        "api_version": "1.3.0",
        "implementation_version": "1",
        "description": "Anti-motion-sickness overlay Vulkan layer",
        "enable_environment": {
            "ENABLE_MOTIONSAFE_LAYER": "1"
        },
        "disable_environment": {
            "DISABLE_MOTIONSAFE_LAYER": "1"
        }
    }
}
